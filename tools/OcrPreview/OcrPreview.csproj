<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the viewer-independent OCR pipeline of the WPF app on any OS, without the viewer. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <DefineConstants>$(DefineConstants);GDPICTURE_API</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GdPicture.API" Version="14.4.9" />
    <Compile Include="..\..\ZonalOcrViewer\OcrPipeline.cs" Link="OcrPipeline.cs" />
  </ItemGroup>

</Project>
